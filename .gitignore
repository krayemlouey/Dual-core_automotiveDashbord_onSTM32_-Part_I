# ============================================================
#  .gitignore — Dual-Core Automotive Dashboard (Part I)
#  STM32H747I-DISCO / TouchGFX / FreeRTOS
# ============================================================

# --- Build outputs ---
Debug/
Release/
build/
*.o
*.d
*.elf
*.hex
*.bin
*.map
*.lst
*.su
*.i
*.s

# --- TouchGFX generated files (keep assets, ignore compiled outputs) ---
CM7/TouchGFX/build/
CM7/TouchGFX/generated/images/
CM7/TouchGFX/generated/fonts/
CM7/TouchGFX/generated/texts/
CM4/TouchGFX/build/
CM4/TouchGFX/generated/images/
CM4/TouchGFX/generated/fonts/
CM4/TouchGFX/generated/texts/

# --- STM32CubeIDE ---
.metadata/
.settings/
STM32CubeIDE/CM7/Debug/
STM32CubeIDE/CM7/Release/
STM32CubeIDE/CM4/Debug/
STM32CubeIDE/CM4/Release/

# --- IDE files ---
*.launch
.cproject
.project
*.mk

# --- Middlewares bulk-generated docs ---
Middlewares/Third_Party/LwIP/doc/doxygen/output/

# --- Map tiles (too large, downloaded at runtime) ---
tiles/
tiles.zip

# --- Temporary / work-in-progress files ---
project_dump*.md
old_main.c
old_msp.c
patch_*.py
temp.png
*.bak
*.backup
*.tmp

# --- Windows ---
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- macOS ---
.DS_Store

# --- Python ---
__pycache__/
*.pyc
*.pyo
